[sub_resource type="Shader" id="Shader_orb"]
code = "shader_type canvas_item;\nuniform vec4 core_color : source_color = vec4(1.0, 0.92, 0.95, 1.0);\nuniform vec4 glow_color : source_color = vec4(1.0, 0.2, 0.42, 1.0);\n\nvoid fragment() {\n\tvec2 uv = UV * 2.0 - 1.0;\n\tfloat dist = length(uv);\n\tfloat core = 1.0 - smoothstep(0.1, 0.45, dist);\n\tfloat glow = pow(max(0.0, 1.0 - dist * 0.92), 3.0) * 0.9;\n\tfloat alpha = clamp(core + glow, 0.0, 1.0);\n\tvec3 col = mix(glow_color.rgb, core_color.rgb, clamp(core, 0.0, 1.0));\n\tCOLOR = vec4(col, alpha);\n}\n"

