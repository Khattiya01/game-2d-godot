[sub_resource type="Shader" id="Shader_dot"]
code = "shader_type canvas_item;
uniform vec4 core_color : source_color = vec4(0.92, 0.98, 1.0, 1.0);
uniform vec4 glow_color : source_color = vec4(0.3, 0.85, 1.0, 1.0);

void fragment() {
	vec2 uv = UV * 2.0 - 1.0;
	float dist = length(uv);
	float core = 1.0 - smoothstep(0.05, 0.38, dist);
	float glow = pow(max(0.0, 1.0 - dist * 0.9), 4.0) * 0.8;
	float alpha = clamp(core + glow, 0.0, 1.0);
	vec3 col = mix(glow_color.rgb, core_color.rgb, clamp(core, 0.0, 1.0));
	COLOR = vec4(col, alpha);
}
"

