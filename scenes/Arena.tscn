shader_parameter/flip = 1.0

[sub_resource type="Shader" id="Shader_center"]
code = "shader_type canvas_item;

uniform vec4 glow_color : source_color = vec4(0.7, 0.9, 1.0, 1.0);

void fragment() {
	float d = abs(UV.x - 0.5) * 2.0;
	float g = pow(max(0.0, 1.0 - d), 2.0);
	COLOR = vec4(glow_color.rgb, g * glow_color.a);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_center"]
shader = SubResource("Shader_center")
shader_parameter/glow_color = Color(0.82, 0.82, 1.0, 0.85)

