[sub_resource type="Shader" id="Shader_bg"]
code = "shader_type canvas_item;

uniform vec2 cell_size = vec2(80.0, 60.0);
uniform vec4 line_color : source_color = vec4(0.1, 0.35, 0.9, 1.0);
uniform float line_alpha = 0.18;
uniform float line_width = 1.0;
uniform vec4 bg_color : source_color = vec4(0.02, 0.02, 0.06, 1.0);

void fragment() {
	vec2 pixel = FRAGCOORD.xy;
	vec2 grid = mod(pixel, cell_size);
	float h = step(cell_size.y - line_width, grid.y);
	float v = step(cell_size.x - line_width, grid.x);
	float on_line = clamp(h + v, 0.0, 1.0);
	COLOR = mix(bg_color, vec4(line_color.rgb, 1.0), on_line * line_alpha);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_bg"]
shader = SubResource("Shader_bg")
shader_parameter/cell_size = Vector2(80, 60)
shader_parameter/line_color = Color(0.15, 0.05, 0.3, 1)
shader_parameter/line_alpha = 0.18
shader_parameter/line_width = 1.0
shader_parameter/bg_color = Color(0.02, 0.02, 0.06, 1)

[sub_resource type="Shader" id="Shader_zone"]
code = "shader_type canvas_item;

uniform vec4 zone_color : source_color = vec4(0.0, 0.4, 1.0, 1.0);
uniform float flip = 0.0;

void fragment() {
	float u = mix(1.0 - UV.x, UV.x, flip);
	float alpha = pow(u, 1.5) * 0.3;
	COLOR = vec4(zone_color.rgb, alpha);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_teamA"]
shader = SubResource("Shader_zone")
shader_parameter/zone_color = Color(0.0, 0.88, 1.0, 1)
shader_parameter/flip = 0.0

[sub_resource type="ShaderMaterial" id="ShaderMaterial_teamB"]
shader = SubResource("Shader_zone")
