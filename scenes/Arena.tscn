[sub_resource type="Shader" id="Shader_bg"]
code = "shader_type canvas_item;\n\nuniform vec2 cell_size = vec2(80.0, 60.0);\nuniform vec4 line_color : source_color = vec4(0.1, 0.35, 0.9, 1.0);\nuniform float line_alpha = 0.18;\nuniform float line_width = 1.0;\nuniform vec4 bg_color : source_color = vec4(0.02, 0.02, 0.06, 1.0);\n\nvoid fragment() {\n\tvec2 pixel = FRAGCOORD.xy;\n\tvec2 grid = mod(pixel, cell_size);\n\tfloat h = step(cell_size.y - line_width, grid.y);\n\tfloat v = step(cell_size.x - line_width, grid.x);\n\tfloat on_line = clamp(h + v, 0.0, 1.0);\n\tCOLOR = mix(bg_color, vec4(line_color.rgb, 1.0), on_line * line_alpha);\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_bg"]
shader = SubResource("Shader_bg")

[sub_resource type="Shader" id="Shader_zone"]
code = "shader_type canvas_item;\n\nuniform vec4 zone_color : source_color = vec4(0.0, 0.4, 1.0, 1.0);\nuniform float flip = 0.0;\n\nvoid fragment() {\n\tfloat u = mix(1.0 - UV.x, UV.x, flip);\n\tfloat alpha = pow(u, 1.5) * 0.3;\n\tCOLOR = vec4(zone_color.rgb, alpha);\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_teamA"]
shader = SubResource("Shader_zone")
shader_parameter/zone_color = Color(0.05, 0.4, 1.0, 1.0)
shader_parameter/flip = 0.0

[sub_resource type="ShaderMaterial" id="ShaderMaterial_teamB"]
shader = SubResource("Shader_zone")
shader_parameter/zone_color = Color(1.0, 0.12, 0.05, 1.0)
shader_parameter/flip = 1.0

[sub_resource type="Shader" id="Shader_center"]
code = "shader_type canvas_item;\n\nuniform vec4 glow_color : source_color = vec4(0.7, 0.9, 1.0, 1.0);\n\nvoid fragment() {\n\tfloat d = abs(UV.x - 0.5) * 2.0;\n\tfloat g = pow(max(0.0, 1.0 - d), 2.0);\n\tCOLOR = vec4(glow_color.rgb, g * glow_color.a);\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_center"]
shader = SubResource("Shader_center")
shader_parameter/glow_color = Color(0.65, 0.88, 1.0, 0.85)

