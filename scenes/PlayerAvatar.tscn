[ext_resource type="Script" path="res://scenes/PlayerAvatar.gd" id="1_avatarScript"]

[sub_resource type="Shader" id="Shader_glow"]
code = "shader_type canvas_item;\nuniform vec4 glow_color : source_color = vec4(0.05, 0.4, 1.0, 1.0);\n\nvoid fragment() {\n\tvec2 uv = UV * 2.0 - 1.0;\n\tfloat dist = length(uv);\n\tfloat ring_dist = abs(dist - 0.78);\n\tfloat glow = exp(-ring_dist * ring_dist * 35.0) * 0.95;\n\tfloat outer = 1.0 - smoothstep(0.9, 1.02, dist);\n\tCOLOR = vec4(glow_color.rgb, glow * outer);\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_glow"]
shader = SubResource("Shader_glow")
shader_parameter/glow_color = Color(0.05, 0.4, 1.0, 1.0)

[sub_resource type="Shader" id="Shader_avatar"]
code = "shader_type canvas_item;\n\nvoid fragment() {\n\tvec2 uv = UV * 2.0 - 1.0;\n\tfloat dist = length(uv);\n\tfloat alpha = 1.0 - smoothstep(0.88, 0.96, dist);\n\tCOLOR = texture(TEXTURE, UV);\n\tCOLOR.a *= alpha;\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_avatar"]
shader = SubResource("Shader_avatar")

